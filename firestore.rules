rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Products (Inventory): Everyone can read, only authenticated users can write (assuming admins/employees)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Orders: Everyone can create an order (customers), but only authenticated users can read/update all orders
    match /orders/{orderId} {
      allow read, update, delete: if isAuthenticated();
      // Allow unauthenticated users to create orders if they are using the customer app
      allow create: if true;
    }

    // Counters (for order numbers, etc.): Only authenticated users can read/write
    match /counters/{counterId} {
      allow read, write: if true; // Technically customers need to read/write this to generate order ID in cart
    }

    // Customers: Only authenticated users can manage customers
    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }
  }
}
